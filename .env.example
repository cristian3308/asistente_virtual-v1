# Copia este archivo como .env y rellena tus valores. .env nunca se sube a git.

# --- Modelos ---
# Clave de OpenCode Go (opcional: sin ella todo funciona en local con Ollama).
OPENCODE_API_KEY=
# Repetir en la nube un turno que el modelo local no resolvió (1/0).
ASSISTANT_AUTO_ESCALATE=1
# Modelos para programar habilidades nuevas, en orden de preferencia.
ASSISTANT_FORGE_MODELS=minimax-m3,kimi-k2.7-code

# --- Tú ---
ASSISTANT_USER_NAME=Cristhian

# --- Telegram (opcional) ---
# Token de @BotFather y tu id numérico de @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Notas (opcional) ---
# Carpeta de tu bóveda de Obsidian donde el asistente puede escribir notas.
OBSIDIAN_VAULT_PATH=

# --- Voz ---
# Whisper en CPU: small entiende mejor, base es más rápido.
WHISPER_MODEL=small
WHISPER_THREADS=8
# Segundos de silencio para dar por terminada tu frase en /conversar.
ASSISTANT_SILENCIO_FIN=4
ASSISTANT_ESPERA_INICIO=8

# --- Avatar flotante ---
ASSISTANT_AVATAR=1

# App web/PWA para el celular (http://127.0.0.1:8765). Ver README: "App en el celular".
ASSISTANT_WEB=1
ASSISTANT_WEB_HOST=127.0.0.1
ASSISTANT_WEB_PORT=8765
# Vacío = se genera uno aleatorio en data/web_token.txt (mínimo 16 caracteres si lo pones tú).
ASSISTANT_WEB_TOKEN=
